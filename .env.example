# =====================================================================
#  Forensic Secure Storage - configuration
#  Copy this file to ".env" (same folder as docker-compose.yml) and edit.
#      Windows CMD:   copy .env.example .env
#  NEVER commit .env - it holds secrets (it is listed in .gitignore).
#  After editing .env, recreate the backend so it picks the values up:
#      docker compose up -d --force-recreate backend
#  (a plain "docker compose restart" does NOT re-read this file)
# =====================================================================

# ---- Security keys (REQUIRED) ----------------------------------------
# Generate two different values, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_long_random_string
JWT_SECRET_KEY=change_this_to_a_different_long_random_string

# development | production   (production refuses to start with placeholder keys
# and hides SMTP diagnostics from API responses)
FLASK_ENV=development

# ---- E-mail / OTP delivery (REQUIRED for sign-up + forgot password) ---
# Gmail: turn on Google 2-Step Verification, then create an App Password at
#   https://myaccount.google.com/apppasswords
# Paste the 16-character App Password below (spaces are ignored).
# Do NOT use your normal Gmail password - Google rejects it for SMTP.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
# Optional: sender address (Gmail forces it to be MAIL_USERNAME). Defaults to MAIL_USERNAME.
# MAIL_FROM=your_email@gmail.com
# (The names SMTP_HOST, SMTP_PORT, SMTP_USERNAME, SMTP_PASSWORD, SMTP_FROM_EMAIL
#  are accepted as aliases of MAIL_SERVER, MAIL_PORT, MAIL_USERNAME, MAIL_PASSWORD, MAIL_FROM.)

# OTP policy (optional - these are the defaults)
# OTP_TTL_MINUTES=10
# OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_MAX_ATTEMPTS=5
# OTP_MAX_SENDS_PER_HOUR=5

# ---- First admin account (optional) -----------------------------------
# If both are set and no admin exists yet, one is created on first start.
# Remove ADMIN_PASSWORD from this file afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=System Administrator

# ---- Evidence upload limits (optional) ---------------------------------
# Evidence is encrypted in memory, so keep this within the container's RAM.
# MAX_UPLOAD_MB=50
# Comma-separated override of the allowed extensions, e.g. pdf,png,jpg,txt
# ALLOWED_UPLOAD_EXTENSIONS=

# ---- URLs --------------------------------------------------------------
# Browser origin(s) allowed to call the API (comma-separated)
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Where the browser reaches the backend (baked into the frontend at build time;
# changing it requires: docker compose up -d --build frontend)
VITE_API_BASE_URL=http://localhost:5000/api

# ---- Evidence storage backend ------------------------------------------
# local = files on the server's disk (development).  s3 = private Amazon S3 bucket.
# For s3 on EC2: attach an IAM ROLE to the instance and DO NOT set AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY here. Full guide: docs/AWS_S3_EC2.md
STORAGE_BACKEND=local
# S3_BUCKET=your-private-evidence-bucket
# AWS_REGION=eu-west-1
# S3_PREFIX=evidence/
# S3_SSE=AES256                 # or aws:kms (then set S3_KMS_KEY_ID)
# S3_KMS_KEY_ID=
# S3_CONNECT_TIMEOUT=5
# S3_READ_TIMEOUT=30
# S3_MAX_RETRIES=3

# ---- Key generation (Equilibrium Optimizer) ----------------------------
# Larger values = slower uploads; they do NOT make keys stronger (see docs/ARCHITECTURE_PHASE2.md).
# EEO_POPULATION=20
# EEO_MAX_ITER=50
