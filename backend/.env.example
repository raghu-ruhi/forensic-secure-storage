# OPTIONAL. For Docker Compose use the single .env in the PROJECT ROOT instead
# (see ../.env.example). This file is only for running `python run.py` without
# Docker, and - if it exists - it overrides the root .env.
# Mail settings are explained in ../.env.example.

# Flask
FLASK_ENV=development
SECRET_KEY=change_this_to_a_long_random_string
JWT_SECRET_KEY=change_this_to_a_different_long_random_string

# Database
DATABASE_URL=postgresql://forensic_user:StrongPass123!@localhost:5432/forensic_db

# Mail (Gmail: use a 16-character App Password, not your real password)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
# MAIL_FROM=your_email@gmail.com
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# Initial Admin bootstrap (optional).
# If both are set, and no admin account exists yet, one admin account is
# created automatically the first time the backend starts. Leave these
# blank after the first run - they are ignored once an admin exists.
# Alternatively, run `python create_admin.py` (or, in Docker,
# `docker compose exec backend python create_admin.py`) at any time instead.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=System Administrator

# Storage
STORAGE_PATH=./storage
MASTER_KEY_PATH=./storage/master.key

# Peer nodes (distributed storage simulation)
NODE_A_PATH=./storage/node_a
NODE_B_PATH=./storage/node_b
NODE_C_PATH=./storage/node_c

# CORS
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
